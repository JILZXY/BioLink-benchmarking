# ==============================================================================
# BioLink Benchmarking - Variables de entorno de ejemplo
# Copiar a .env antes de ejecutar:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS:        cp .env.example .env
# Nunca guardar credenciales reales ni productivas en este repositorio.
# ==============================================================================

# --- Red local y configuración general del benchmark ---
BENCH_BIND_HOST=127.0.0.1
BENCH_PROJECT_NAME=biolink-benchmarking
BENCH_SEED=20261120
BENCH_WARMUP_ITERATIONS=5
BENCH_MEASURE_ITERATIONS=30
BENCH_TIMEOUT_SECONDS=60
BENCH_STATS_INTERVAL_SECONDS=0.5
BENCH_MAX_TOTAL_MEM_MB=4096

# --- Relacional A: MySQL 8.4 LTS (límite 768 MB; 8.4.12 no publicado en Docker Hub, se fija 8.4.13) ---
MYSQL_IMAGE=mysql:8.4.13
MYSQL_PORT=3307
MYSQL_MEM_LIMIT=768m
MYSQL_CPUS=2.0
MYSQL_DATABASE=biolink_bench
MYSQL_USER=biolink_bench
MYSQL_PASSWORD=CHANGE_ME_BENCH_MYSQL_PASS
MYSQL_ROOT_PASSWORD=CHANGE_ME_BENCH_MYSQL_ROOT

# --- Relacional B: PostgreSQL 18.7 (límite 768 MB) ---
POSTGRES_IMAGE=postgres:18.7
POSTGRES_PORT=5433
POSTGRES_MEM_LIMIT=768m
POSTGRES_CPUS=2.0
POSTGRES_DB=biolink_bench
POSTGRES_USER=biolink_bench
POSTGRES_PASSWORD=CHANGE_ME_BENCH_PG_PASS

# --- Documental A: MongoDB Community Server 8.0 (límite 768 MB) ---
MONGODB_IMAGE=mongo:8.0.38
MONGODB_PORT=27018
MONGODB_MEM_LIMIT=768m
MONGODB_CPUS=2.0
MONGODB_DB=biolink_bench
MONGODB_USER=biolink_bench
MONGODB_PASSWORD=CHANGE_ME_BENCH_MONGO_PASS

# --- Documental B: Apache CouchDB 3.5.3 (límite 768 MB) ---
COUCHDB_IMAGE=couchdb:3.5.3
COUCHDB_PORT=5985
COUCHDB_MEM_LIMIT=768m
COUCHDB_CPUS=2.0
COUCHDB_USER=biolink_bench
COUCHDB_PASSWORD=CHANGE_ME_BENCH_COUCH_PASS
COUCHDB_DB_PREFIX=biolink_bench

# --- Grafo A: Neo4j Community (límite 1,024 MB; contraseña >= 8 caracteres) ---
NEO4J_IMAGE=neo4j:2026.10.2-community
NEO4J_BOLT_PORT=7688
NEO4J_HTTP_PORT=7475
NEO4J_MEM_LIMIT=1024m
NEO4J_CPUS=2.0
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_BENCH_NEO4J_PASS

# --- Grafo B: Memgraph Community (límite 1,024 MB) ---
MEMGRAPH_IMAGE=memgraph/memgraph:3.14.0
MEMGRAPH_BOLT_PORT=7689
MEMGRAPH_MEM_LIMIT=1024m
MEMGRAPH_CPUS=2.0
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
